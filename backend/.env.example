DB_HOST=.
DB_NAME=BD_ROOMI
DB_DRIVER="ODBC Driver 18 for SQL Server"
# Deja ambos vacíos para usar autenticación de Windows.
DB_USER=
DB_PASSWORD=
# Usa yes únicamente para una instancia local con certificado autofirmado.
DB_TRUST_SERVER_CERTIFICATE=no
# Genera una clave aleatoria propia de 32 bytes o más.
ROOMI_JWT_SECRET=

# Moderación automática (precio mensual en soles)
ROOMI_PRECIO_MINIMO=50
ROOMI_PRECIO_MAXIMO=2000
ROOMI_TERMINOS_PROHIBIDOS=
